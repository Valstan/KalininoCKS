# Раз в сутки: сообщество публикует посты нечасто, а каждый прогон тянет медиа.
#
# Persistent=true — если бокс был выключен в момент срабатывания, прогон случится
# после включения, а не пропадёт. RandomizedDelaySec размазывает нагрузку на шлюз
# Сарафана: у соседних сайтов такие же таймеры.

[Unit]
Description=KalininoCKS — ежесуточный импорт постов из ВК

[Timer]
OnCalendar=*-*-* 06:40:00
RandomizedDelaySec=20m
Persistent=true
Unit=kalinino-vk-sync.service

[Install]
WantedBy=timers.target
