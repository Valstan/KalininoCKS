# ─────────────────────────────────────────────────────────────────────────────
# МКУК Калининская ЦКС — пример переменных окружения.
#
# ⚠️ Это ШАБЛОН. Реальные значения НЕ коммитим (pool #008 «секреты вне репо»).
#   • Локально:  скопировать в web/.env и подставить значения (web/.env в .gitignore).
#   • На проде:  секреты живут в env-файле сервиса (root-only) и подключаются
#                systemd-юнитом через EnvironmentFile=, НЕ в дереве репо.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. Локально (Windows + системный Postgres): postgres/postgres.
DATABASE_URI=

# Payload auth secret (шифрует JWT). На проде — длинная случайная строка.
PAYLOAD_SECRET=

# Публичный URL сервера (без хвостового слэша).
NEXT_PUBLIC_SERVER_URL=https://сдк-калинино.вмалмыже.рф

# Порт приложения. Прод-юнит читает PORT из своего env-файла на сервере;
# Next standalone (server.js) уважает PORT. Локальный дефолт — 3000.
PORT=3000

# Keep-alive HTTP-сервера, мс (G234). Должен быть ДЛИННЕЕ idle-таймаута прокси,
# иначе nginx штатно шлёт запрос в сокет, который Node только что закрыл, — и
# приходит 502 при пустых логах приложения, на случайной позиции серии POST.
# Next standalone (server.js) читает именно эту переменную; флага запуска у него нет.
# Прод: 65000 при 60 с у nginx.
KEEP_ALIVE_TIMEOUT=65000

# ─── Автоимпорт постов из ВК (временный мотор до конвейера Сарафана, D-015) ───
# Шлюз Сарафана: ключ и адрес. ОБА обязательны — без них роут /api/vk-sync/run отвечает
# 503, а скрипты scripts/vk-*.mjs выходят с ошибкой. Значения в репозитории не хранятся
# (AGENTS.md §🛡), они в env-файле сервиса; здесь только имена — их публиковать можно.
# URL задавать ПОЛНЫЙ, вместе с путём точки вызова (…/api/gateway/call): код дописывать
# путь не будет, и голый origin даст 404 с сообщением про ключ, а не про адрес.
SARAFAN_GATEWAY_URL=
SARAFAN_GATEWAY_KEY=
# Секрет триггера /api/vk-sync/run. Таймер на сервере шлёт его в Authorization: Bearer.
# Наружу путь не выставлен, но секрет обязателен: без него роут отвечает 401.
VK_SYNC_SECRET=
# Рубильник. Пусто или не «1» → роут отвечает 503 и ничего не делает.
# Гасится в день, когда конвейер Сарафана начнёт присылать посты сам.
VK_SYNC_ENABLED=
# Публикация. Пусто → посты приезжают ЧЕРНОВИКАМИ в /admin (осознанный режим на
# первые недели: рубрикатор — подсказка, решает человек). «1» → сразу публикуются.
VK_SYNC_PUBLISH=
# Сколько записей стены смотрим и сколько импортируем за один прогон.
# Афиши — картинка без единого слова текста. Берём их (решение владельца 22.08:
# это анонсы мероприятий). Заголовок собирается из даты: «Афиша от 11 июня 2026 г.».
# «1» — перестать их тянуть.
VK_SYNC_SKIP_POSTERS=
VK_SYNC_FETCH_COUNT=30
VK_SYNC_LIMIT=5

# ─── Веб-аналитика (D-017) ────────────────────────────────────────────────────
# Номер счётчика Яндекс.Метрики. Читается на РАНТАЙМЕ (/api/analytics-config,
# /api/analytics-informer), а не запекается в бандл: сменить или выключить счётчик
# можно правкой env-файла на сервере + рестартом сервиса, без пересборки.
# Пусто → счётчик не грузится, информер отдаёт прозрачный 1×1.
# Прод: 111854806 (счётчик «СДК Калинино», домен сдк-калинино.вмалмыже.рф) —
# номер публичен, он и так уезжает в браузер посетителя.
YM_COUNTER_ID=

# ─── SMTP-relay для исходящих писем (опционально) ─────────────────────────────
# Пока SMTP_HOST пуст — email-адаптер в payload.config НЕ подключается, письма
# пишутся в консоль; сборка/типы при этом зелёные. Чтобы письма реально уходили,
# заполнить все SMTP_* (на проде — в env-файле сервиса).
#   port 465 → secure=true (implicit TLS), 587/2525 → secure=false (STARTTLS).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@сдк-калинино.вмалмыже.рф
# SMTP_FROM_NAME=Калининская ЦКС
# SMTP_SECURE=false

# Прод (IDN сдк-калинино.вмалмыже.рф → punycode):
# NEXT_PUBLIC_SERVER_URL=https://xn----8sbksaibjtblz.xn--80adkdyec4j.xn--p1ai
